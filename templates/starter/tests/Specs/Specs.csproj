<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Reqnroll writes each feature's code-behind under obj/, so no
         generated file lands in the tree, and a feature file outside this
         project can be linked in. -->
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Moq.Analyzers" />
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The pinned feature files, at the repo root. Every one of them is compiled here. -->
    <ReqnrollFeatureFiles Include="../../specs/features/**/*.feature" Link="Features/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <!-- Builds the program with this project, in its configuration, so a step can launch it. -->
    <ProjectReference Include="../../src/App/App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The path of the built program goes into the test assembly, resolved by MSBuild for the configuration of this build. -->
  <Target Name="ProgramPathIntoAssembly" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../../src/App/App.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="BuiltProgram" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="BuiltProgram" Value="@(BuiltProgram->'%(FullPath)')" />
    </ItemGroup>
  </Target>
</Project>
